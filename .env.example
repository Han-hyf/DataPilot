DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# PostgreSQL admin connection, used only by scripts/seed_ecommerce.py
DATABASE_ADMIN_URL=postgresql://datapilot_admin:datapilot_admin@localhost:5432/datapilot

# Read-only connection used by the Agent
DATABASE_URL=postgresql://datapilot_reader:datapilot_reader@localhost:5432/datapilot

# Agent calls the database through the in-process MCP Client/Server transport.
DATAPILOT_USE_MCP=true

# Docker initialization values (local development only)
POSTGRES_DB=datapilot
POSTGRES_USER=datapilot_admin
POSTGRES_PASSWORD=datapilot_admin
DATAPILOT_DB_USER=datapilot_reader
DATAPILOT_DB_PASSWORD=datapilot_reader

# Docker Compose API and deterministic seed options
DATAPILOT_API_PORT=8000
SEED_USERS=10000
SEED_PRODUCTS=500
SEED_ORDERS=50000
SEED_RANDOM_SEED=20260819
